{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://math-vis.local/widgets/mchaos-w1/schema.json",
  "title": "mchaos-w1 widget params",
  "description": "Verbatim-renderer slug for an inline widget on the mathematical-chaos topic.",
  "meta": {
    "family": "verbatim",
    "dimension": "2d",
    "gesture": "interactive",
    "role": "interactive"
  },
  "type": "object",
  "additionalProperties": false,
  "required": ["widgetId","title","hint","bodyMarkup","bodyScript"],
  "properties": {
    "widgetId": {"type":"string","pattern":"^[A-Za-z][A-Za-z0-9_-]*$"},
    "title": {"type":"string"},
    "hint": {"type":"string"},
    "bodyMarkup": {"type":"string","minLength":1,"x-artifact":true},
    "bodyScript": {"type":"string","x-artifact":true}
  }
}
