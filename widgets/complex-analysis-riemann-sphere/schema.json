{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://math-vis.local/widgets/complex-analysis-riemann-sphere/schema.json",
  "title": "complex-analysis-riemann-sphere widget params",
  "description": "Stereographic-projection visualizer for the Riemann sphere. The unit-diameter sphere sits tangent to the plane at the origin; the reader moves a point z in the plane (modulus + argument sliders, or a preset), and the widget projects it from the north pole to its image on the sphere, drawn in a fixed oblique 3-D view. As |z|→∞ the image climbs to the north pole (= ∞); |z|=1 lands on the equator. The geometry is intrinsic; params carry only optional preset points.",
  "meta": {
    "family": "complex-analysis-riemann-sphere",
    "dimension": "2d",
    "gesture": "interact",
    "role": "exploratory"
  },
  "type": "object",
  "additionalProperties": false,
  "required": ["widgetId", "title"],
  "properties": {
    "widgetId": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_-]*$", "description": "DOM id; the script derives -mod/-arg/-svg/-out." },
    "title": { "type": "string", "description": "Display title rendered inside .hd > .ttl." },
    "hint": { "type": "string", "description": "Optional short hint rendered inside .hd > .hint." },
    "presets": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "description": "Notable points the reader can jump to.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "label", "mod", "arg"],
        "properties": {
          "id": { "type": "string", "pattern": "^[A-Za-z0-9_-]+$", "description": "Stable option value." },
          "label": { "type": "string", "description": "Plain-text dropdown label (no LaTeX)." },
          "mod": { "type": "number", "minimum": 0, "maximum": 3, "description": "|z|." },
          "arg": { "type": "number", "description": "arg z in radians." }
        }
      }
    }
  }
}
