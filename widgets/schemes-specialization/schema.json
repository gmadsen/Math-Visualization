{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://math-vis.local/widgets/schemes-specialization/schema.json",
  "title": "schemes-specialization widget params",
  "description": "Generic-points / specialization explorer. A small excerpt of Spec R is drawn as a poset by height — the generic point at the top, curve generic points in the middle, closed points at the bottom — with edges p → q whenever p ⊊ q (p specializes to q). Clicking a point highlights its closure V(p) = {q : p ⊆ q}, the irreducible subvariety it is the generic point of. The poset (nodes + specialization edges) comes from params.",
  "meta": {
    "family": "schemes-specialization",
    "dimension": "2d",
    "gesture": "interact",
    "role": "exploratory"
  },
  "type": "object",
  "additionalProperties": false,
  "required": ["widgetId", "title", "nodes", "edges"],
  "properties": {
    "widgetId": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_-]*$", "description": "DOM id; the script derives -svg/-out." },
    "title": { "type": "string", "description": "Display title rendered inside .hd > .ttl." },
    "hint": { "type": "string", "description": "Optional short hint rendered inside .hd > .hint." },
    "nodes": {
      "type": "array",
      "minItems": 2,
      "maxItems": 12,
      "description": "The prime ideals shown.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "label", "height", "geom"],
        "properties": {
          "id": { "type": "string", "pattern": "^[A-Za-z0-9_-]+$", "description": "Stable node id (referenced by edges)." },
          "label": { "type": "string", "description": "Plain-text prime label (e.g. '(x,y)')." },
          "height": { "type": "integer", "minimum": 0, "maximum": 4, "description": "Vertical level: generic point highest, closed points 0." },
          "geom": { "type": "string", "maxLength": 60, "description": "Plain-text geometric meaning of V(p)." }
        }
      }
    },
    "edges": {
      "type": "array",
      "minItems": 1,
      "maxItems": 24,
      "description": "Specialization cover edges [from, to] with from ⊊ to (from is the more generic point).",
      "items": {
        "type": "array",
        "minItems": 2,
        "maxItems": 2,
        "items": { "type": "string" }
      }
    }
  }
}
